<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjectListApp.Views"
             xmlns:Data="clr-namespace:GithubApiDLL.Data;assembly=GithubApiDLL" xmlns:Converters="clr-namespace:ProjectListApp.Converters" xmlns:ViewModels="clr-namespace:ProjectListApp.ViewModels" x:Class="ProjectListApp.Views.UserConnexion"
             mc:Ignorable="d" Height="100" Width="770">
    <UserControl.Resources>
        <Converters:StreamToImageConverter x:Key="StreamToImageConverter"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <ViewModels:VMUserConnexion/>
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- pour l'image -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <!-- prend tout l'espace restant -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image x:Name="userImage"  Source="{Binding GithubUser.AvatarImage, Converter={StaticResource StreamToImageConverter}, FallbackValue=pack://application:\,\,\,/Views/image.png, IsAsync=True, Mode=OneWay, TargetNullValue=pack://application:\,\,\,/Views/image.png}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,5,5,5" Width="90" Height="90"/>
        <Border x:Name="imageAndInfoSeparator" Grid.Column="1" Padding="4,0,0,0" RenderTransformOrigin="0.5,0.5" >
            <Border.Background>
                <LinearGradientBrush>
                    <GradientStop Offset="0" Color="Transparent"/>
                    <GradientStop Offset="1" Color="Transparent"/>
                    <GradientStop x:Name="gradienColorStop1" Color="Black" Offset="0.2"/>
                    <GradientStop x:Name="gradienColorStop2" Color="Black" Offset="0.8"/>
                </LinearGradientBrush>
            </Border.Background>

        </Border>
        <Grid Margin="10,5,0,5" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Label HorizontalAlignment="Center" Content="Username :" VerticalAlignment="Center"/>
                <Label x:Name="username" Grid.Column="1" Content="{Binding GithubUser.UserName}" VerticalAlignment="Center"/>
            </Grid>
            
            <Grid Grid.Row="1" VerticalAlignment="Bottom" Height="46">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label x:Name="DeviceCodeLabel" Content="Label" Grid.Row
                       ="0" Visibility="Collapsed"/>
                <Grid Grid.Row="1" VerticalAlignment="Bottom">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding GithubUser.Token}" VerticalAlignment="Center" Grid.IsSharedSizeScope="True" Width="300"/>
                    <Button Content="Button" VerticalAlignment="Center" Click="Button_Click" Grid.Column="1" Margin="10,0,0,0"/>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
